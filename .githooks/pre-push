#!/bin/sh
# Production moves only by a merged pull request, so direct pushes to master are blocked.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    echo "Direct push to master is blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
